{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Game (Edge)",
            "request": "launch",
            "type": "pwa-msedge",
            "file": "${workspaceFolder}/index.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Launch Game (Chrome)",
            "request": "launch",
            "type": "pwa-chrome",
            "file": "${workspaceFolder}/index.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Launch Map Editor (Edge)",
            "request": "launch",
            "type": "pwa-msedge",
            "file": "${workspaceFolder}/map-editor.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Launch Map Editor (Chrome)",
            "request": "launch",
            "type": "pwa-chrome",
            "file": "${workspaceFolder}/map-editor.html",
            "webRoot": "${workspaceFolder}"
        }
    ]
}